<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetBottom="@dimen/miuix_floating_navigation_item_inset_vertical"
            android:insetLeft="@dimen/miuix_floating_navigation_item_inset_horizontal"
            android:insetRight="@dimen/miuix_floating_navigation_item_inset_horizontal"
            android:insetTop="@dimen/miuix_floating_navigation_item_inset_vertical">
            <shape>
                <solid android:color="@color/miuix_floating_navigation_selected" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetBottom="@dimen/miuix_floating_navigation_item_inset_vertical"
            android:insetLeft="@dimen/miuix_floating_navigation_item_inset_horizontal"
            android:insetRight="@dimen/miuix_floating_navigation_item_inset_horizontal"
            android:insetTop="@dimen/miuix_floating_navigation_item_inset_vertical">
            <shape>
                <solid android:color="@android:color/transparent" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>
</selector>
