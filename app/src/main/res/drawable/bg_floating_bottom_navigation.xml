<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/floating_bottom_navigation_surface" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/floating_bottom_navigation_surface_tint" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="2dp"
                android:color="@color/floating_bottom_navigation_stroke" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
