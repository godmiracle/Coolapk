<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal" />

    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="@dimen/miuix_floating_navigation_outer_padding"
        android:layout_marginEnd="@dimen/miuix_floating_navigation_outer_padding"
        android:layout_marginBottom="@dimen/miuix_floating_navigation_bottom_padding"
        android:background="@drawable/bg_miuix_floating_navigation"
        android:elevation="0dp"
        app:layout_anchor="@id/viewPager"
        app:layout_anchorGravity="bottom">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/miuix_floating_navigation_inner_padding"
            android:paddingEnd="@dimen/miuix_floating_navigation_inner_padding"
            android:stateListAnimator="@null"
            app:itemActiveIndicatorStyle="@style/MiuixFloatingNavigationActiveIndicator"
            app:itemBackground="@drawable/bg_miuix_floating_navigation_item"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/miuix_floating_navigation_item_tint"
            app:itemPaddingBottom="4dp"
            app:itemPaddingTop="4dp"
            app:itemRippleColor="@color/miuix_floating_navigation_ripple"
            app:itemTextColor="@color/miuix_floating_navigation_item_tint"
            app:itemTextAppearanceActive="@style/MiuixFloatingNavigationLabelActive"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:itemTextAppearanceInactive="@style/MiuixFloatingNavigationLabelInactive"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/nav_menu" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
